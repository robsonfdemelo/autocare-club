generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PlanStatus {
  ACTIVE
  CANCELED
  EXPIRED
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELED
}

enum PaymentMode {
  DIRECT
  CLUB
}

enum UserRole {
  ADMIN
  CUSTOMER
}

model User {
  id               String    @id @default(cuid())
  name             String?
  email            String?   @unique
  password         String?
  image            String?
  phone            String?
  role             UserRole  @default(CUSTOMER)
  resetToken       String?
  resetTokenExpiry DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  appointments Appointment[]
  userPlan     UserPlan?
  payments     Payment[]
}

model Workshop {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  imageUrl    String
  phone       String?
  whatsapp    String?
  email       String?
  address     String
  city        String
  state       String
  zipCode     String?
  latitude    Decimal? @db.Decimal(10, 7)
  longitude   Decimal? @db.Decimal(10, 7)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  revisionServices RevisionService[]
  appointments     Appointment[]
}

model RevisionService {
  id            String   @id @default(cuid())
  name          String
  slug          String
  description   String?
  imageUrl      String?
  mileageTarget Int
  monthInterval Int      @default(12)
  priceDirect   Decimal  @db.Decimal(10, 2)
  priceClub     Decimal  @db.Decimal(10, 2)
  isActive      Boolean  @default(true)
  workshopId    String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workshop     Workshop      @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@unique([workshopId, slug])
  @@index([workshopId])
}

model Appointment {
  id                String            @id @default(cuid())
  appointmentDate   DateTime
  status            AppointmentStatus @default(SCHEDULED)
  paymentMode       PaymentMode       @default(DIRECT)
  usedPlan          Boolean           @default(false)
  notes             String?
  userId            String
  workshopId        String
  revisionServiceId String
  userPlanId        String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  workshop        Workshop        @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  revisionService RevisionService @relation(fields: [revisionServiceId], references: [id], onDelete: Cascade)
  userPlan        UserPlan?       @relation(fields: [userPlanId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([workshopId])
  @@index([revisionServiceId])
  @@index([appointmentDate])
}

model PlanPackage {
  id           String   @id @default(cuid())
  name         String
  revisionsQty Int
  discountPct  Int
  graceDays    Int
  price        Decimal  @default(0) @db.Decimal(10, 2)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userPlans UserPlan[]
  payments  Payment[]
}

model UserPlan {
  id               String     @id @default(cuid())
  userId           String     @unique
  planPackageId    String
  status           PlanStatus @default(ACTIVE)
  totalRevisions   Int
  usedRevisions    Int        @default(0)
  availableBalance Int
  graceUntil       DateTime
  startedAt        DateTime   @default(now())
  expiresAt        DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  planPackage  PlanPackage   @relation(fields: [planPackageId], references: [id], onDelete: Restrict)
  appointments Appointment[]

  @@index([planPackageId])
}

model Payment {
  id             String   @id @default(cuid())
  userId         String
  planPackageId  String
  asaasPaymentId String   @unique
  status         String
  value          Decimal  @db.Decimal(10, 2)
  invoiceUrl     String?
  billingType    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user        User        @relation(fields: [userId], references: [id])
  planPackage PlanPackage @relation(fields: [planPackageId], references: [id])
}
